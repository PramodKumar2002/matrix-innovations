# Matrix Innovations - Frontend Environment Variables
# Copy this file to .env for local frontend development:
# Copy-Item .env.example .env

# Base URL pointing to the FastAPI backend
# Local Development: http://127.0.0.1:8000
# Production: Your deployed Vercel backend URL (e.g., https://matrix-backend.vercel.app or empty if served on same domain)
VITE_API_BASE_URL=http://127.0.0.1:8000

# ==============================================================================
# Matrix Innovations - Backend Environment Variables Configuration
# ==============================================================================
# IMPORTANT:
# 1. Do NOT commit the actual .env file with real credentials to Git!
# 2. Duplicate this file as ".env" inside the backend/ directory for local development:
#    Copy-Item .env.example .env
# 3. For production on Vercel, set these in: Project Settings -> Environment Variables.
# ==============================================================================

# MongoDB Atlas Connection String
# Get this from MongoDB Atlas -> Clusters -> Connect -> Drivers -> Python
# Example: mongodb+srv://matrix_admin:YourStrongPassword123@cluster0.xxxx.mongodb.net/?retryWrites=true&w=majority
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.xxxxx.mongodb.net/?retryWrites=true&w=majority

# MongoDB Database Name
MONGODB_DATABASE=matrix_innovations

# Secret Admin API Key for accessing private contact messages:
# e.g., GET /api/contact, GET /api/contact/{id}, DELETE /api/contact/{id}
# Generate a strong key (e.g., using Python: secrets.token_urlsafe(32))
ADMIN_API_KEY=replace_with_a_secure_random_api_key_for_admin_access_12345

# Allowed CORS Origins (comma-separated list of allowed frontend origins)
# In production, add your Vercel deployment URL (e.g. https://matrix-innovations.vercel.app)
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:3000

# Application Environment (development, test, production)
ENVIRONMENT=development

# Server Port (used for local Uvicorn development)
PORT=8000
